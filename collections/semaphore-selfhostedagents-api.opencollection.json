{
  "opencollection": "1.0.0",
  "info": {
    "name": "Semaphore Public Dashboards SelfHostedAgents API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "SelfHostedAgents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SelfHostedAgents.List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org_name}.semaphoreci.com/api/v2/agents",
            "params": [
              {
                "name": "agent_type",
                "value": "",
                "type": "query",
                "description": "The name of the agent type to filter for. If not specified, agents for all agent types will be returned."
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query",
                "description": "Starting point for listing, if you are fetching first page leave it empty"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Page size"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all registered self-hosted agents. Optionally filter by agent type."
        },
        {
          "info": {
            "name": "SelfHostedAgents.Describe",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org_name}.semaphoreci.com/api/v2/agents/:agent_name",
            "params": [
              {
                "name": "agent_name",
                "value": "",
                "type": "path",
                "description": "Unique name of the self-hosted agent."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Describe a single registered self-hosted agent by agent name."
        }
      ]
    }
  ],
  "bundled": true
}