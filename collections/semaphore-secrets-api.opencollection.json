{
  "opencollection": "1.0.0",
  "info": {
    "name": "Semaphore Public Dashboards Secrets API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Secrets.List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org_name}.semaphoreci.com/api/v2/secrets",
            "params": [
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Ordering of the secrets"
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query",
                "description": "Starting point for listing, if you are fetching first page leave it empty"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Page size"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all organization level secrets.\n      If the response does not fit all the secrets refer to the link header to get next page url."
        },
        {
          "info": {
            "name": "Secrets.Create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{org_name}.semaphoreci.com/api/v2/secrets",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create an organization secret."
        },
        {
          "info": {
            "name": "Secrets.Describe",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org_name}.semaphoreci.com/api/v2/secrets/:id_or_name",
            "params": [
              {
                "name": "id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the secret"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Describe an organization secret with md5 contents."
        },
        {
          "info": {
            "name": "Secrets.Update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{org_name}.semaphoreci.com/api/v2/secrets/:id_or_name",
            "params": [
              {
                "name": "id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the secret"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an organization secret."
        },
        {
          "info": {
            "name": "Secrets.Delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{org_name}.semaphoreci.com/api/v2/secrets/:id_or_name",
            "params": [
              {
                "name": "id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the secret"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an organization secret."
        }
      ]
    }
  ],
  "bundled": true
}