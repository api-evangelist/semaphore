{
  "opencollection": "1.0.0",
  "info": {
    "name": "Semaphore Public Dashboards ProjectSecrets API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "ProjectSecrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ProjectSecrets.List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org_name}.semaphoreci.com/api/v2/projects/:project_id_or_name/secrets",
            "params": [
              {
                "name": "project_id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the project"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Ordering of the secrets"
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query",
                "description": "Starting point for listing, if you are fetching first page leave it empty"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Page size"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all project level secrets in a project.\n      If the response does not fit all the secrets refer to the link header to get next page url."
        },
        {
          "info": {
            "name": "ProjectSecrets.Create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{org_name}.semaphoreci.com/api/v2/projects/:project_id_or_name/secrets",
            "params": [
              {
                "name": "project_id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the project"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a project scoped secret."
        },
        {
          "info": {
            "name": "ProjectSecrets.Describe",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{org_name}.semaphoreci.com/api/v2/projects/:project_id_or_name/secrets/:id_or_name",
            "params": [
              {
                "name": "project_id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the project"
              },
              {
                "name": "id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the secret"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Describe project secret with md5 contents."
        },
        {
          "info": {
            "name": "ProjectSecrets.Update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{org_name}.semaphoreci.com/api/v2/projects/:project_id_or_name/secrets/:id_or_name",
            "params": [
              {
                "name": "project_id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the project"
              },
              {
                "name": "id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the secret"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a project scoped secret."
        },
        {
          "info": {
            "name": "ProjectSecrets.Delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{org_name}.semaphoreci.com/api/v2/projects/:project_id_or_name/secrets/:id_or_name",
            "params": [
              {
                "name": "project_id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the project"
              },
              {
                "name": "id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the secret"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a project secret."
        }
      ]
    }
  ],
  "bundled": true
}