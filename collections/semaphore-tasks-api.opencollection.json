            "name": "Tasks.Trigger",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{org_name}.semaphoreci.com/api/v2/projects/:project_id_or_name/tasks/:task_id/triggers",
            "params": [
              {
                "name": "project_id_or_name",
                "value": "",
                "type": "path",
                "description": "Id or name of the project"
              },
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
