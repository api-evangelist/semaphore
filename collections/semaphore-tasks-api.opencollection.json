                "value": "",
                "type": "path",
                "description": "Id or name of the project"
              },
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update (patch) task with given params"
        },
        {
          "info": {
            "name": "Tasks.Delete",
            "type": "http"
